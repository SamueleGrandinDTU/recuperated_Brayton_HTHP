{
  "figure": {
    "figsize": [6, 5],
    "dpi": 300,
    "facecolor": "#FFFFFF",

    "width_single": 3.34,
    "width_double": 6.18,
    "axes_size": 2.46,
    "margins": {
      "left": 0.60,
      "right": 0.08,
      "bottom": 0.52,
      "top": 0.12,
      "title": 0.22,
      "title_line": 0.16,
      "legend_row": 0.19,
      "row_gap": 0.75,
      "col_gap_min": 0.56
    }
  },

  "fonts": {
    "title": 18,
    "label": 13,
    "value": 11,
    "legend": 9,
    "tick": 12,
    "isoline": 10,
    "small_label": 7,
    "annotation": 7
  },

  "paper_fonts": {
    "family": "serif",
    "mathtext": "dejavuserif",
    "title": 10,
    "label": 9,
    "tick": 8,
    "legend": 8,
    "annotation": 7
  },

  "component_names": {
    "compressor":   "CP 1",
    "compressor 1": "CP 1",
    "compressor 2": "CP 2",
    "turbine":      "TU",
    "sink":         "HX1",
    "sink 1":       "HX1",
    "sink 2":       "HX2",
    "interface hx": "HX3"
  },

  "colors": {
    "default": "#1f77b4",
    "destruction": "#d62728",
    "fuel": "#ff7f0e",
    "product": "#2ca02c",
    "process": "#ff0000",
    "reference": "#0000ff",
    "point": "#ff0000",
    "label": "#000000",
    "edge": "black"
  },

  "lines_and_markers": {
    "linewidth": 1.0,
    "point_size": 3
  },

  "layout": {
    "auto_x_padding": 0.2,
    "auto_y_padding": 20,
    "label_x_offset": 0.01,
    "label_y_offset": 5
  },

  "grid": {
    "color": "#EAEAEA",
    "linestyle": "-",
    "linewidth": 0.5,
    "alpha": 0.7
  },

  "axes": {
    "spine_color": "#B5B5B5",
    "spine_linewidth": 0.7,
    "facecolor": "#FFFFFF",
    "box_aspect": 1
  },

  "ticks": {
    "axis": "both",
    "which": "both",
    "pad": 3,
    "color": "#B5B5B5",
    "labelcolor": "#333333",
    "direction": "in"
  },

  "table": {
    "fig_width": 12,
    "min_fig_height": 4,
    "row_height": 0.5,
    "scale_x": 1.2,
    "scale_y": 2.0,
    "title_pad": 20
  },

  "ts_diagram": {
    "isoline_quality": {
      "start": 0,
      "end": 1,
      "num": 2
    },
    "isoline_enthalpy": {
      "start": 0,
      "end": 3501,
      "step": 1000
    }
  },

  "directional_labels": {
    "0": [0.01, -2.0],
    "1": [0.01, -2.0],
    "2": [0.01, 0.0],
    "2i": [0.0, -2.5],
    "3i": [-0.01, 0.0],
    "3": [-0.01, 0.0],
    "4": [-0.01, 0.0],
    "5": [-0.01, 0.0]
  },

  "cycle_label_keys": {
    "S-BR":   "standalone_base",
    "S-IR":   "standalone_intercooled",
    "TES-BR": "tes_base",
    "TES-IR": "tes_intercooled"
  },

  "cycle_colors": {
    "standalone_base": "#002aff",
    "standalone_intercooled": "#ff2a00",
    "tes_base": "#65ccff",
    "tes_intercooled": "#ff9932"
  },

  "hx_colors": {
    "hot":  ["#ff2a00", "#ff9932"],
    "cold": ["#002aff", "#3299ff"]
  },

  "component_colors": {
    "compressor":   "#002aff",
    "compressor 1": "#002aff",
    "compressor 2": "#1965ff",
    "turbine":      "#3299ff",
    "sink":         "#ff2a00",
    "sink 1":       "#ff2a00",
    "sink 2":       "#ff6619",
    "recuperator":  "#ff9932",
    "interface hx": "#ffcc65",
    "tank 1":       "#7f7f7f",
    "tank 2":       "#b3b3b3",
    "hitec salt":   "#e0e0e0"
  },

  "operational_strategy": {
    "colors": {
      "electricity_price": "#404040",
      "heat_demand": "#ffcc65",
      "hthp": "#ff6619",
      "tes": "#1965ff"
    },
    "aspect": 0.75,
    "aspect_single": 0.45,
    "right_extra": 0.95,
    "col_gap": 0.15,
    "tes_axis_offset_pt": 36,
    "max_time_ticks": 8
  },

  "lcoh_category_colors": {
    "CAPEX":           "#1965ff",
    "Electricity":     "#ff6619",
    "O&M":             "#ff9932",
    "Labour":          "#ffcc65",
    "Decommissioning": "#7f7f7f"
  }
}